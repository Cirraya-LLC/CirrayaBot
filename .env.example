# ./start.sh copies this to .env and fills in random secrets — usually no manual edits needed.

# ── Name of this deployment ───────────────────────────────
# compose names containers and volumes after it. ⚠️ Must be changed when running a second
# deployment on the same machine — otherwise the second one ATTACHES TO THE FIRST ONE'S
# database container, the passwords differ, and the app hangs at "Waiting for PostgreSQL…".
COMPOSE_PROJECT_NAME=multi-agent

# ── Database ──────────────────────────────────────────────
# compose starts the postgres container with it. start.sh generates it on first run.
POSTGRES_PASSWORD=
# Only set this to point at an existing PostgreSQL instead of the bundled one
# DATABASE_URL=postgres://user:pass@host:5432/multiagent

# ── Optional modules ──────────────────────────────────────
# Comma-separated. Today there is one: studio (the film studio).
# Empty = the chat alone (db + app). start.sh picks this on a first run from the machine's memory;
# change it and rerun ./start.sh — it turns this into compose profiles and tells the app.
MODULES=studio

# ── Memory ceilings ───────────────────────────────────────
# start.sh fills these for the machine it runs on (under 6 GB: DB 768m, app 768m, studio 1g
# — ~2.5 GB in all, for a 2-core / 4 GB box). A value you set yourself is kept.
# DB_MEMORY=  APP_MEMORY=  STUDIO_MEMORY=  PG_SHARED_BUFFERS=  APP_HEAP_MB=  STUDIO_HEAP_MB=

# ── Studio (studio/) ──────────────────────────────────────
# Both generated by start.sh. STUDIO_TOKEN is what the app uses to call the studio;
# STUDIO_DB_PASSWORD is the studio's own database role (it can't read the app's tables).
STUDIO_TOKEN=
STUDIO_DB_PASSWORD=
# The studio → platform direction: it posts "candidates ready" into a group with this (generated).
STUDIO_EVENT_TOKEN=
# Model keys for the studio. They go into the studio container only. The Keys panel in the UI
# can set them too (stored in the studio's own table) and wins over these.
# Seedance: ModelArk (https://ark.ap-southeast.bytepluses.com) or a relay with the same paths
# (/api/v3/contents/generations/tasks). Limits are per project; a project's info can lower them.
SEEDANCE_BASE_URL=
SEEDANCE_API_KEY=
SEEDANCE_PER_HOUR=40
SEEDANCE_CONCURRENT=4
# GPT image: OpenAI directly, or a relay speaking the Images API. The base includes /v1.
GPT_IMAGE_BASE_URL=https://api.openai.com/v1
GPT_IMAGE_API_KEY=
GPT_IMAGE_MODEL=gpt-image-1
# ComfyUI on this machine: http://host.docker.internal:8188 (its workflow lives in project info).
COMFY_URL=
# MiniMax speech for narration and off-screen lines: the key is enough. Base: https://api.minimax.cn
# (mainland, the default) or https://api.minimax.io (international) — a key only works on its own site.
# Model: speech-2.8-hd by default; speech-2.8-turbo is cheaper.
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=

# ── Access ────────────────────────────────────────────────
# Access token. start.sh generates it on first run; open the page with ?k=<token>
ACCESS_TOKEN=
WEB_PORT=8080
# Optional password-only browser login (web/password.mjs). Store only the scrypt hash.
LOGIN_PASSWORD_HASH=
# Shared only with the trusted HTTPS reverse proxy; never publish the value.
WEB_PROXY_SECRET=
# Address the port is published on. By default only this machine can connect.
# Set 0.0.0.0 for access from other machines — ACCESS_TOKEN is then the only door.
BIND_ADDR=127.0.0.1

# ── Agent containers ──────────────────────────────────────
# on = every Agent can run arbitrary commands IN ITS OWN CONTAINER.
# This is the "can get hands-on like a real employee" switch; it also means whoever has
# ACCESS_TOKEN has a container shell. Off by default.
AGENT_TOOLS=off
AGENT_IMAGE=multi-agent-worker:2
AGENT_MEMORY=2g
AGENT_CPUS=2
AGENT_EXEC_TIMEOUT=120
# Prefix for Agent container names.
# Container names are global on the host — change it when running a second deployment on
# the same machine.
AGENT_PREFIX=ma
# Absolute host path of the workspace. start.sh fills it in; never write a relative path.
WORKSPACE_HOST_PATH=
# Container runtime socket. start.sh switches it for podman.
DOCKER_SOCK=/var/run/docker.sock

# ── Model upstream ────────────────────────────────────────
# OPTIONAL: if set, the first start creates the first upstream from it, saving a trip to the UI.
# After that the ⚙ settings in the UI are authoritative; changing these has no effect.
BOT_LLM_BASE_URL=
BOT_LLM_API_KEY=
BOT_LLM_MODEL=

# ── Optional local media deployment (deploy/DEPLOYMENT.md) ──
# COMPOSE_FILE=docker-compose.yml:docker-compose.local-media.yml
# MODULES=studio,cli
# SEEDANCE_MODEL_20=seedance-2.0
# SEEDANCE_MODEL_25=seedance-2.5
# Generate independent random secrets of at least 32 characters; do not reuse cloud keys.
CODEX_IMAGE_TOKEN=
LOCAL_TTS_TOKEN=
