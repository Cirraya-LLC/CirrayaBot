# ./start.sh copies this to .env and fills in random secrets — usually no manual edits needed.

# ── Name of this deployment ───────────────────────────────
# compose names containers and volumes after it. ⚠️ Must be changed when running a second
# deployment on the same machine — otherwise the second one ATTACHES TO THE FIRST ONE'S
# database container, the passwords differ, and the app hangs at "Waiting for PostgreSQL…".
COMPOSE_PROJECT_NAME=multi-agent

# ── Database ──────────────────────────────────────────────
# compose starts the postgres container with it. start.sh generates it on first run.
POSTGRES_PASSWORD=
# Only set this to point at an existing PostgreSQL instead of the bundled one
# DATABASE_URL=postgres://user:pass@host:5432/multiagent

# ── Access ────────────────────────────────────────────────
# Access token. start.sh generates it on first run; open the page with ?k=<token>
ACCESS_TOKEN=
WEB_PORT=8080
# Address the port is published on. By default only this machine can connect.
# Set 0.0.0.0 for access from other machines — ACCESS_TOKEN is then the only door.
BIND_ADDR=127.0.0.1

# HTTPS, in addition to http on WEB_PORT. Set a domain that points at this machine and port 443
# is reachable on, and start.sh adds a Caddy in front that gets the certificate by itself.
# Empty = http only. No domain of your own? <ip-with-dashes>.sslip.io resolves to that IP.
PUBLIC_HOST=
# Address 443 is published on.
HTTPS_BIND=0.0.0.0

# ── Agent containers ──────────────────────────────────────
# on = every Agent can run arbitrary commands IN ITS OWN CONTAINER.
# This is the "can get hands-on like a real employee" switch; it also means whoever has
# ACCESS_TOKEN has a container shell. Off by default.
AGENT_TOOLS=off
AGENT_IMAGE=multi-agent-worker:4
# Where the agent image's apt downloads from when it is built. Empty = Debian's own CDN.
AGENT_APT_MIRROR=
# internet (default) = agents reach the internet, but not this host or your LAN; open = everything
AGENT_EGRESS=internet
AGENT_MEMORY=2g
AGENT_CPUS=2
AGENT_EXEC_TIMEOUT=120
# Prefix for Agent container names. Container names are global on the host —
# change it when running a second deployment on the same machine.
AGENT_PREFIX=ma
# Absolute host path of the workspace. start.sh fills it in; never write a relative path.
WORKSPACE_HOST_PATH=
# Container runtime socket. start.sh switches it for podman.
DOCKER_SOCK=/var/run/docker.sock

# ── Secrets agents use without seeing them ────────────────
# The key they are sealed with (64 hex characters). Empty = one is generated into the workspace as
# .secret-key on first use. Lose the key and the stored secrets are lost — back it up with the data.
SECRET_KEY=
# https origins an agent's http_request may reach although they resolve to internal addresses
# (a service on your LAN), comma-separated. Everything else internal is refused.
HTTP_REQUEST_ALLOW=

# ── Model upstream ────────────────────────────────────────
# OPTIONAL: if set, the first start creates the first upstream from it, saving a trip to the UI.
# After that the ⚙ settings in the UI are authoritative; changing these has no effect.
BOT_LLM_BASE_URL=
BOT_LLM_API_KEY=
BOT_LLM_MODEL=
